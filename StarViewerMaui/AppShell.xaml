<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="StarViewerMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:StarViewerMaui"
    Shell.FlyoutBehavior="Flyout">

    <FlyoutItem Title="星巡りViewer" Icon="star.png">
        <ShellContent Title="星巡りViewer" ContentTemplate="{DataTemplate local:StarViewerPage}" />
    </FlyoutItem>
    <FlyoutItem Title="アスペクトViewer" Icon="star.png">
        <ShellContent Title="アスペクトViewer" ContentTemplate="{DataTemplate local:StarAspects}" />
    </FlyoutItem>
    <FlyoutItem Title="星巡りViewer（日時指定）" Icon="star.png">
        <ShellContent Title="星巡りViewer（日時指定）" ContentTemplate="{DataTemplate local:StarViewerPage2}" />
    </FlyoutItem>
    <FlyoutItem Title="アスペクトViewer（日時指定）" Icon="star.png">
        <ShellContent Title="アスペクトViewer（日時指定）" ContentTemplate="{DataTemplate local:StarAspects2}" />
    </FlyoutItem>
</Shell>